# ============================================================
#  Meeting Intelligence Agent — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your actual .env file to version control.
# ============================================================

# ─── Core App ───────────────────────────────────────────────
APP_ENV=development                     # development | production
SECRET_KEY=                             # REQUIRED: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ───────────────────────────────────────────────
# Neon PostgreSQL (recommended) or any Postgres 15+ with pgvector
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL_SYNC=postgresql://user:password@host:5432/dbname

# ─── File Storage ───────────────────────────────────────────
# Options: local | s3 | r2
STORAGE_BACKEND=local

# Local disk (only used when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (used when STORAGE_BACKEND=s3)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cloudflare R2 (used when STORAGE_BACKEND=r2)
# S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY above still apply
S3_ENDPOINT_URL=                        # e.g. https://<account>.r2.cloudflarestorage.com

# Upload limits
MAX_UPLOAD_SIZE_MB=500

# ─── Inference — Cloud (default) ───────────────────────────
# Groq: LLaMA-3.3-70B + LLaMA-3.1-8B + Whisper-large-v3
GROQ_API_KEY=                           # REQUIRED for cloud mode: gsk_...

# OpenAI: text-embedding-3-small for chunk embeddings
OPENAI_API_KEY=                         # sk-...

# OpenRouter: fallback LLM provider
OPENROUTER_API_KEY=                     # sk-or-...

# ─── Inference — Self-Hosted (optional) ────────────────────
# Set STORAGE_BACKEND=local and point to your local inference servers
HF_TOKEN=                               # hf_... (for downloading models)
VLLM_BASE_URL=http://localhost:8001     # vLLM OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434  # Ollama endpoint

# ─── Rate Limiting & Job Queue ──────────────────────────────
# Upstash Redis (free tier works fine for development)
UPSTASH_REDIS_REST_URL=                 # https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=              # AX...

# Redis URL for Arq background worker queue
REDIS_URL=redis://localhost:6379

# ─── Authentication & Encryption ────────────────────────────
ENCRYPTION_KEY=                         # base64-encoded 32-byte Fernet key
                                        # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── Integrations ───────────────────────────────────────────

# SendGrid (email summaries)
SENDGRID_API_KEY=                       # SG....
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# Slack (meeting digest webhook)
SLACK_WEBHOOK_URL=                      # https://hooks.slack.com/services/...

# Jira (auto-create tickets from action items)
JIRA_BASE_URL=                          # https://yourorg.atlassian.net
JIRA_API_TOKEN=                         # ATATT...
JIRA_USER_EMAIL=                        # user@yourorg.com
JIRA_DEFAULT_PROJECT_KEY=              # e.g. MEET

# Google Calendar (follow-up event creation)
GOOGLE_CALENDAR_CREDENTIALS=           # path/to/credentials.json (OAuth2)
GOOGLE_CALENDAR_TOKEN=                  # path/to/token.json (auto-generated)

# ─── Policy Gate ────────────────────────────────────────────
# Restrict where the agent can send data.
# Leave blank to allow all (development). Restrict in production.
POLICY_ALLOWED_EMAIL_DOMAINS=          # Comma-separated: company.com,partner.org
POLICY_MAX_JIRA_TICKETS=10             # Max Jira tickets created per meeting
POLICY_MAX_SLACK_MESSAGES=5            # Max Slack messages sent per meeting

# ─── Observability ──────────────────────────────────────────
# OpenTelemetry — ship traces to Jaeger, Tempo, or any OTLP backend
OTEL_EXPORTER_OTLP_ENDPOINT=          # http://localhost:4317
OTEL_SERVICE_NAME=meeting-intelligence-agent

# Grafana admin credentials (change before exposing to network)
# Used by docker-compose.yml — override here or in a secrets manager
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                # REQUIRED: set a strong password in production

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend (Next.js) ─────────────────────────────────────
# Prefix NEXT_PUBLIC_ variables are exposed to the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

